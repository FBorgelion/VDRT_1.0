@rendermode InteractiveServer

<div class="nav-shell">
    <a class="navbar-brand"
       href=""
       aria-label="Retour au tableau de bord">
        <img src="images/vdrt-logo.png"
             alt="VDRT - Van Damme R." />
    </a>

    <button type="button"
            class="menu-toggle @(_menuIsOpen ? "menu-toggle--open" : null)"
            aria-label="Afficher ou masquer la navigation"
            aria-expanded="@_menuIsOpen"
            aria-controls="main-navigation"
            @onclick="ToggleMenu">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <nav id="main-navigation"
         class="nav-links @(_menuIsOpen ? "nav-links--open" : null)"
         aria-label="Navigation principale">

        <NavLink class="nav-link"
                 href=""
                 Match="NavLinkMatch.All"
                 @onclick="CloseMenu">
            Tableau de bord
        </NavLink>

        <NavLink class="nav-link"
                 href="imports"
                 @onclick="CloseMenu">
            Importations
        </NavLink>

        <NavLink class="nav-link"
                 href="activities"
                 @onclick="CloseMenu">
            Anomalies
        </NavLink>

        <NavLink class="nav-link"
                 href="drivers"
                 @onclick="CloseMenu">
            Chauffeurs
        </NavLink>

        <NavLink class="nav-link"
                 href="vehicles"
                 @onclick="CloseMenu">
            Véhicules
        </NavLink>

        <NavLink class="nav-link"
                 href="sites"
                 @onclick="CloseMenu">
            Chantiers
        </NavLink>

        <NavLink class="nav-link"
                 href="settings"
                 @onclick="CloseMenu">
            Paramètres
        </NavLink>
    </nav>
</div>

@code {
    private bool _menuIsOpen;

    private void ToggleMenu()
    {
        _menuIsOpen = !_menuIsOpen;
    }

    private void CloseMenu()
    {
        _menuIsOpen = false;
    }
}